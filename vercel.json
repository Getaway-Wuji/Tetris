{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bash scripts/build-vercel.sh install",
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ]
}
